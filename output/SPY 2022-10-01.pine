            leg_base := priceHigh
        else if legendPos == "Top Left"
            leg_x := pr_w0_ts - 86400000 * 30
            leg_base := priceHigh
        else if legendPos == "Bottom Left"
            leg_x := pr_w0_ts - 86400000 * 30
            leg_base := priceLow
        else
            leg_x := todayTime + 86400000 * 7
            leg_base := priceLow
