            array.push(allLabels, label.new(leg_x, leg_base, "Primary Count (55%)", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=PR_MOTIVE_UP, textcolor=color.white, size=size.small, textalign=text.align_center))
