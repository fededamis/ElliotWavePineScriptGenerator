        array.push(swWB_p,  pr_wa_p)
        array.push(swWB_names, "WB.sw0")
        array.push(swWB_ohlc, "L")
        array.push(swWB_fibs, "--")
        array.push(swWB_ts, pr_wbswa_ts)
        array.push(swWB_p,  pr_wbswa_p)
        array.push(swWB_names, "WB.swa")
        array.push(swWB_ohlc, "H")
        array.push(swWB_fibs, "--")
        array.push(swWB_ts, pr_wbswb_ts)
        array.push(swWB_p,  pr_wbswb_p)
        array.push(swWB_names, "WB.swb")
        array.push(swWB_ohlc, "L")
        array.push(swWB_fibs, "45.9%")
        array.push(swWB_ts, pr_wbswc_ts)
        array.push(swWB_p,  pr_wbswc_p)
        array.push(swWB_names, "WB.swc")
        array.push(swWB_ohlc, "H")
        array.push(swWB_fibs, "210.1%")

        int sWBi = 1
        while sWBi < array.size(swWB_ts)
            array.push(allLines, line.new(array.get(swWB_ts, sWBi - 1), array.get(swWB_p, sWBi - 1), array.get(swWB_ts, sWBi), array.get(swWB_p, sWBi), xloc=xloc.bar_time, color=swDnCol, style=STYLE_DASHED, width=1))
            sWBi += 1

        if showLabels
            int sli = 0
            while sli < array.size(swWB_ts)
                bool is_coincident = sli == 0 or sli == array.size(swWB_ts) - 1
                if not is_coincident
                    string slohlc   = array.get(swWB_ohlc, sli)
                    float  slp      = array.get(swWB_p, sli)
                    string slf      = array.get(swWB_fibs, sli)
                    string sltooltip = "$" + str.tostring(slp, "#.##") + (slf != "--" ? "\nFib:" + slf : "")
                    float  sw_yoff  = slohlc == "H" ? priceRange * 0.04 : -(priceRange * 0.04)
                    if slohlc == "H"
                        array.push(allLabels, label.new(array.get(swWB_ts, sli), slp + sw_yoff, array.get(swWB_names, sli), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=swDnCol, textcolor=color.white, size=size.tiny, textalign=text.align_center, tooltip=sltooltip))
                    else
                        array.push(allLabels, label.new(array.get(swWB_ts, sli), slp + sw_yoff, array.get(swWB_names, sli), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, color=swDnCol, textcolor=color.white, size=size.tiny, textalign=text.align_center, tooltip=sltooltip))
                sli += 1

        // WC subwaves
        array<int>    swWC_ts    = array.new<int>()
        array<float>  swWC_p     = array.new<float>()
        array<string> swWC_names = array.new<string>()
        array<string> swWC_ohlc  = array.new<string>()
        array<string> swWC_fibs  = array.new<string>()
        array.push(swWC_ts, pr_wb_ts)
        array.push(swWC_p,  pr_wb_p)
        array.push(swWC_names, "WC.sw0")
        array.push(swWC_ohlc, "H")
        array.push(swWC_fibs, "--")
        array.push(swWC_ts, pr_wcswa_ts)
        array.push(swWC_p,  pr_wcswa_p)
        array.push(swWC_names, "WC.swa")
        array.push(swWC_ohlc, "L")
        array.push(swWC_fibs, "--")
        array.push(swWC_ts, pr_wcswb_ts)
        array.push(swWC_p,  pr_wcswb_p)
        array.push(swWC_names, "WC.swb")
        array.push(swWC_ohlc, "H")
        array.push(swWC_fibs, "70.1%")
        array.push(swWC_ts, pr_wcswc_ts)
        array.push(swWC_p,  pr_wcswc_p)
        array.push(swWC_names, "WC.swc")
        array.push(swWC_ohlc, "L")
        array.push(swWC_fibs, "472.9%")

        int sWCi = 1
        while sWCi < array.size(swWC_ts)
            array.push(allLines, line.new(array.get(swWC_ts, sWCi - 1), array.get(swWC_p, sWCi - 1), array.get(swWC_ts, sWCi), array.get(swWC_p, sWCi), xloc=xloc.bar_time, color=swDnCol, style=STYLE_DASHED, width=1))
            sWCi += 1

        if showLabels
            int sli = 0
            while sli < array.size(swWC_ts)
                bool is_coincident = sli == 0 or sli == array.size(swWC_ts) - 1
                if not is_coincident
                    string slohlc   = array.get(swWC_ohlc, sli)
                    float  slp      = array.get(swWC_p, sli)
                    string slf      = array.get(swWC_fibs, sli)
                    string sltooltip = "$" + str.tostring(slp, "#.##") + (slf != "--" ? "\nFib:" + slf : "")
                    float  sw_yoff  = slohlc == "H" ? priceRange * 0.04 : -(priceRange * 0.04)
                    if slohlc == "H"
                        array.push(allLabels, label.new(array.get(swWC_ts, sli), slp + sw_yoff, array.get(swWC_names, sli), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=swDnCol, textcolor=color.white, size=size.tiny, textalign=text.align_center, tooltip=sltooltip))
                    else
                        array.push(allLabels, label.new(array.get(swWC_ts, sli), slp + sw_yoff, array.get(swWC_names, sli), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, color=swDnCol, textcolor=color.white, size=size.tiny, textalign=text.align_center, tooltip=sltooltip))
                sli += 1

    // === CHANNEL ===
    if showChannel and drawPrimary
        float ch_slope      = (pr_w3_p - pr_w1_p) / float(pr_w3_ts - pr_w1_ts)
        int   ch_start_ts   = pr_w0_ts
        int   ch_end_ts     = pr_wx5_ts
        float mot_y_start   = pr_w1_p + ch_slope * float(ch_start_ts - pr_w1_ts)
        float mot_y_end     = pr_w1_p + ch_slope * float(ch_end_ts   - pr_w1_ts)
        float base_y_start  = pr_w2_p + ch_slope * float(ch_start_ts - pr_w2_ts)
        float base_y_end    = pr_w2_p + ch_slope * float(ch_end_ts   - pr_w2_ts)
        array.push(allLines, line.new(ch_start_ts, mot_y_start,  ch_end_ts, mot_y_end,  xloc=xloc.bar_time, color=color.new(PR_CHANNEL_COL, 50), style=STYLE_DASHED, width=1))
        array.push(allLines, line.new(ch_start_ts, base_y_start, ch_end_ts, base_y_end, xloc=xloc.bar_time, color=color.new(PR_CHANNEL_COL, 50), style=STYLE_DASHED, width=1))

    if showChannel and drawAlternate
        float al_ch_slope     = (al_wiii_p - al_wi_p) / float(al_wiii_ts - al_wi_ts)
        int   al_ch_start_ts  = al_w0_ts
        int   al_ch_end_ts    = al_awc_ts
        float al_mot_y_start  = al_wi_p + al_ch_slope * float(al_ch_start_ts - al_wi_ts)
        float al_mot_y_end    = al_wi_p + al_ch_slope * float(al_ch_end_ts   - al_wi_ts)
        float al_base_y_start = al_wii_p + al_ch_slope * float(al_ch_start_ts - al_wii_ts)
        float al_base_y_end   = al_wii_p + al_ch_slope * float(al_ch_end_ts   - al_wii_ts)
        array.push(allLines, line.new(al_ch_start_ts, al_mot_y_start,  al_ch_end_ts, al_mot_y_end,  xloc=xloc.bar_time, color=color.new(AL_CHANNEL_COL, 50), style=STYLE_DASHED, width=1))
        array.push(allLines, line.new(al_ch_start_ts, al_base_y_start, al_ch_end_ts, al_base_y_end, xloc=xloc.bar_time, color=color.new(AL_CHANNEL_COL, 50), style=STYLE_DASHED, width=1))

    // === INVALIDATION LEVELS ===
    if showInval
        if drawPrimary
            array.push(allLines, line.new(pr_w0_ts, pr_inval, pr_wx5_ts, pr_inval, xloc=xloc.bar_time, color=PR_INVAL_COL, style=STYLE_DASHED, width=1))
            if showLabels
                array.push(allLabels, label.new(pr_w0_ts, pr_inval, "Primary Inval\n$" + str.tostring(pr_inval, "#.##"), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, color=PR_INVAL_COL, textcolor=color.white, size=size.small, textalign=text.align_center))
        if drawAlternate
            array.push(allLines, line.new(al_w0_ts, al_inval, al_awc_ts, al_inval, xloc=xloc.bar_time, color=AL_INVAL_COL, style=STYLE_DASHED, width=1))
            if showLabels
                array.push(allLabels, label.new(al_w0_ts, al_inval, "Alt Inval\n$" + str.tostring(al_inval, "#.##"), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, color=AL_INVAL_COL, textcolor=color.white, size=size.small, textalign=text.align_center))

    // === TARGET LEVELS ===
    if showTargets
        if drawPrimary
            array.push(allLines, line.new(pr_wx2_ts, pr_target, pr_wx5_ts, pr_target, xloc=xloc.bar_time, color=PR_TARGET_COL, style=STYLE_DOTTED, width=1))
            if showLabels
                array.push(allLabels, label.new(pr_wx5_ts, pr_target, "Primary Target\n$" + str.tostring(pr_target, "#.##") + "\nFib " + pr_target_fib, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, color=PR_TARGET_COL, textcolor=color.black, size=size.small, textalign=text.align_center))
        if drawAlternate
            array.push(allLines, line.new(al_awb_ts, al_target, al_awc_ts, al_target, xloc=xloc.bar_time, color=AL_TARGET_COL, style=STYLE_DOTTED, width=1))
            if showLabels
                array.push(allLabels, label.new(al_awc_ts, al_target, "Alt Target\n$" + str.tostring(al_target, "#.##") + "\nFib " + al_target_fib, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, color=AL_TARGET_COL, textcolor=color.white, size=size.small, textalign=text.align_center))

    // === LEGEND ===
    if showLegend
        float legendStep = priceRange * 0.04
        int   leg_x      = 0
        float leg_base   = 0.0
        if legendPos == "Top Right"
            leg_x   := todayTime + 86400000 * 7
            leg_base := priceHigh
        else if legendPos == "Top Left"
            leg_x   := pr_w0_ts - 86400000 * 30
            leg_base := priceHigh
        else if legendPos == "Bottom Left"
            leg_x   := pr_w0_ts - 86400000 * 30
            leg_base := priceLow
        else
            leg_x   := todayTime + 86400000 * 7
            leg_base := priceLow
        if drawPrimary
            array.push(allLabels, label.new(leg_x, leg_base, "Primary Count (74%)", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=PR_MOTIVE_UP, textcolor=color.white, size=size.small, textalign=text.align_center))
        if drawAlternate
            array.push(allLabels, label.new(leg_x, leg_base - legendStep, "Alternate Count (47%)", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=AL_MOTIVE_UP, textcolor=color.white, size=size.small, textalign=text.align_center))
        if showSubwaves and drawPrimary
            array.push(allLabels, label.new(leg_x, leg_base - legendStep * 2.0, "Subwaves (Primary)", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(PR_MOTIVE_UP, swLabelTransp), textcolor=color.white, size=size.small, textalign=text.align_center))
