//@version=6
indicator("ETHUSD Elliott Wave Count", overlay=true, max_lines_count=500, max_labels_count=500)

// === INPUTS ===
string showCount = input.string("Primary Only", "Show Count", options=["Primary Only", "Both", "Alternate Only"])
bool showInval = input.bool(true, "Show Invalidation Levels")
bool showTargets = input.bool(true, "Show Targets")
bool showLegend = input.bool(true, "Show Legend")
string legendPos = input.string("Bottom Right", "Legend Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"])
bool showProj = input.bool(true, "Show Projections")
bool showLabels = input.bool(true, "Show Labels")
bool showSubwaves = input.bool(true, "Show Subwaves")

// === STYLE CONSTANTS AS STRINGS ===
string STYLE_SOLID = line.style_solid
string STYLE_DASHED = line.style_dashed
string STYLE_DOTTED = line.style_dotted

// === COLOR INPUTS ===
color PR_MOTIVE_UP  = input.color(color.aqua,              "Primary Up (Motive)",   group="Colors")
color PR_MOTIVE_DN  = input.color(color.fuchsia,           "Primary Down (Motive)", group="Colors")
color PR_CORRECTIVE = input.color(color.orange,            "Primary Corrective",    group="Colors")
color PR_INVAL_COL  = input.color(color.red,               "Invalidation Level",    group="Colors")
color PR_TARGET_COL = input.color(color.lime,              "Target Level",          group="Colors")
color AL_MOTIVE_UP  = input.color(color.rgb(85, 153, 170), "Alt Up (Motive)",       group="Colors")
color AL_MOTIVE_DN  = input.color(color.rgb(170, 85, 170), "Alt Down (Motive)",     group="Colors")
color AL_CORRECTIVE = input.color(color.rgb(170, 119, 51), "Alt Corrective",        group="Colors")
color AL_INVAL_COL  = input.color(color.rgb(204, 68, 68),  "Alt Invalidation",      group="Colors")
color AL_TARGET_COL = input.color(color.rgb(68, 136, 68),  "Alt Target",            group="Colors")
int swLabelTransp   = input.int(55, "Subwave Label Transparency", minval=0, maxval=100, group="Colors")

// === ARRAYS FOR CLEANUP ===
var array<line> allLines = array.new<line>()
var array<label> allLabels = array.new<label>()

// === HELPER FUNCTIONS (top-level, no type annotations on params) ===

getSegColor(isUp, isPrimary) =>
    color result = na
    if isPrimary
        result := isUp ? PR_MOTIVE_UP : PR_CORRECTIVE
    else
        result := isUp ? AL_MOTIVE_UP : AL_CORRECTIVE
    result

getPrLineStyle(isHist, isPrimary, isAlternateOnly) =>
    string result = STYLE_SOLID
    if not isHist
        result := STYLE_DOTTED
    else
        if isPrimary
            result := STYLE_SOLID
        else
            if isAlternateOnly
                result := STYLE_SOLID
            else
                result := STYLE_DASHED
    result

makePivotText(waveName, price, fib, isAlt, isProj) =>
    string line1 = ""
    if isAlt and isProj
        line1 := "(A)(proj) " + waveName
    else if isAlt
        line1 := "(A) " + waveName
    else if isProj
        line1 := "(proj) " + waveName
    else
        line1 := waveName
    string line2 = "$" + str.tostring(price, "#.##")
    string line3 = fib != "--" ? "Fib:" + fib : ""
    string result = line3 != "" ? line1 + "\n" + line2 + "\n" + line3 : line1 + "\n" + line2
    result

// === PRIMARY COUNT DATA ===
int pr_w0_ts = timestamp(2022, 6, 13)
float pr_w0_p = 896.11
int pr_w1_ts = timestamp(2022, 8, 8)
float pr_w1_p = 2022.79
int pr_w2_ts = timestamp(2022, 11, 21)
float pr_w2_p = 1081.14
int pr_w3_ts = timestamp(2024, 3, 11)
float pr_w3_p = 4092.28
int pr_w4_ts = timestamp(2024, 8, 5)
float pr_w4_p = 2122.55
int pr_w5_ts = timestamp(2024, 12, 16)
float pr_w5_p = 4106.96
int pr_wa_ts = timestamp(2025, 3, 10)
float pr_wa_p = 1760.94
int pr_wb_ts = timestamp(2026, 5, 4)
float pr_wb_p = 2934.00
int pr_wc_ts = timestamp(2026, 8, 2)
float pr_wc_p = 1484.00

float pr_inval = 4106.96
float pr_target = 1484.00
string pr_target_fib = "61.8%"

// === ALTERNATE COUNT DATA ===
int al_wa_ts = timestamp(2022, 6, 13)
float al_wa_p = 896.11
int al_wa2_ts = timestamp(2024, 3, 11)
float al_wa2_p = 4092.28
int al_wb_ts = timestamp(2025, 3, 10)
float al_wb_p = 1760.94
int al_wcp_ts = timestamp(2026, 4, 6)
float al_wcp_p = 2800.00
int al_wc_ts = timestamp(2026, 6, 17)
float al_wc_p = 3736.00
int al_wd_ts = timestamp(2026, 9, 7)
float al_wd_p = 4957.00

float al_inval = 896.11
float al_target = 3736.00
string al_target_fib = "61.8%"

// === PRIMARY SUBWAVE DATA ===
// W1 subwaves
int pr_w1sw1_ts = timestamp(2022, 6, 13)
float pr_w1sw1_p = 896.11
int pr_w1sw2_ts = timestamp(2022, 7, 11)
float pr_w1sw2_p = 1019.22
int pr_w1sw3_ts = timestamp(2022, 7, 25)
float pr_w1sw3_p = 1774.58
int pr_w1sw4_ts = timestamp(2022, 8, 1)
float pr_w1sw4_p = 1567.85
int pr_w1sw5_ts = timestamp(2022, 8, 8)
float pr_w1sw5_p = 2022.79

// W2 subwaves
int pr_w2swa_ts = timestamp(2022, 10, 10)
float pr_w2swa_p = 1209.28
int pr_w2swb_ts = timestamp(2022, 10, 31)
float pr_w2swb_p = 1661.33
int pr_w2swc_ts = timestamp(2022, 11, 21)
float pr_w2swc_p = 1081.14

// W3 subwaves
int pr_w3sw1_ts = timestamp(2023, 4, 10)
float pr_w3sw1_p = 2137.45
int pr_w3sw2_ts = timestamp(2023, 10, 8)
float pr_w3sw2_p = 1523.24
int pr_w3sw3_ts = timestamp(2024, 2, 26)
float pr_w3sw3_p = 3518.97
int pr_w3sw4_ts = timestamp(2024, 3, 4)
float pr_w3sw4_p = 3224.12
int pr_w3sw5_ts = timestamp(2024, 3, 11)
float pr_w3sw5_p = 4092.28

// W4 subwaves
int pr_w4swa_ts = timestamp(2024, 4, 29)
float pr_w4swa_p = 2815.92
int pr_w4swb_ts = timestamp(2024, 5, 20)
float pr_w4swb_p = 3943.55
int pr_w4swc_ts = timestamp(2024, 8, 5)
float pr_w4swc_p = 2122.55

// W5 subwaves
int pr_w5sw1_ts = timestamp(2024, 8, 19)
float pr_w5sw1_p = 2820.02
int pr_w5sw2_ts = timestamp(2024, 9, 2)
float pr_w5sw2_p = 2150.86
int pr_w5sw3_ts = timestamp(2024, 12, 2)
float pr_w5sw3_p = 4093.17
int pr_w5sw4_ts = timestamp(2024, 12, 9)
float pr_w5sw4_p = 3520.37
int pr_w5sw5_ts = timestamp(2024, 12, 16)
float pr_w5sw5_p = 4106.96

// WA subwaves
int pr_waswa_ts = timestamp(2025, 1, 27)
float pr_waswa_p = 2755.47
int pr_waswb_ts = timestamp(2025, 2, 17)
float pr_waswb_p = 2850.61
int pr_waswc_ts = timestamp(2025, 3, 10)
float pr_waswc_p = 1760.94

// === ALTERNATE SUBWAVE DATA ===
// Alt WA subwaves (motive impulse)
int al_wasw1_ts = timestamp(2022, 8, 8)
float al_wasw1_p = 2022.79
int al_wasw2_ts = timestamp(2022, 11, 21)
float al_wasw2_p = 1081.14
int al_wasw3_ts = timestamp(2024, 3, 11)
float al_wasw3_p = 4092.28

// Alt WB subwaves
int al_wbswa_ts = timestamp(2024, 8, 5)
float al_wbswa_p = 2122.55
int al_wbswb_ts = timestamp(2024, 12, 16)
float al_wbswb_p = 4106.96
int al_wbswc_ts = timestamp(2025, 3, 10)
float al_wbswc_p = 1760.94

// All drawing objects use xloc.bar_time + fixed float prices for scale/zoom stability
if barstate.islast
    // Clean up old drawings
    while array.size(allLines) > 0
        line.delete(array.pop(allLines))
    while array.size(allLabels) > 0
        label.delete(array.pop(allLabels))

    int todayTime = time
    float priceHigh = 4957.00
    float priceLow = 896.11
    float priceRange = priceHigh - priceLow

    // === BUILD PRIMARY ARRAYS ===
    array<int> pr_ts = array.new<int>()
    array<float> pr_prices = array.new<float>()
    array<string> pr_names = array.new<string>()
    array<string> pr_ohlc = array.new<string>()
    array<string> pr_fibs = array.new<string>()
    array<string> pr_types = array.new<string>()

    array.push(pr_ts, pr_w0_ts)
    array.push(pr_prices, pr_w0_p)
    array.push(pr_names, "W0")
    array.push(pr_ohlc, "L")
    array.push(pr_fibs, "--")
    array.push(pr_types, "hist")

    array.push(pr_ts, pr_w1_ts)
    array.push(pr_prices, pr_w1_p)
    array.push(pr_names, "W1")
    array.push(pr_ohlc, "H")
    array.push(pr_fibs, "--")
    array.push(pr_types, "hist")

    array.push(pr_ts, pr_w2_ts)
    array.push(pr_prices, pr_w2_p)
    array.push(pr_names, "W2")
    array.push(pr_ohlc, "L")
    array.push(pr_fibs, "83.6%")
    array.push(pr_types, "hist")

    array.push(pr_ts, pr_w3_ts)
    array.push(pr_prices, pr_w3_p)
    array.push(pr_names, "W3")
    array.push(pr_ohlc, "H")
    array.push(pr_fibs, "2.67x")
    array.push(pr_types, "hist")

    array.push(pr_ts, pr_w4_ts)
    array.push(pr_prices, pr_w4_p)
    array.push(pr_names, "W4")
    array.push(pr_ohlc, "L")
    array.push(pr_fibs, "65.4%")
    array.push(pr_types, "hist")

    array.push(pr_ts, pr_w5_ts)
    array.push(pr_prices, pr_w5_p)
    array.push(pr_names, "W5")
    array.push(pr_ohlc, "H")
    array.push(pr_fibs, "1.76x")
    array.push(pr_types, "hist")

    array.push(pr_ts, pr_wa_ts)
    array.push(pr_prices, pr_wa_p)
    array.push(pr_names, "WA")
    array.push(pr_ohlc, "L")
    array.push(pr_fibs, "73.1%")
    array.push(pr_types, "hist")

    array.push(pr_ts, pr_wb_ts)
    array.push(pr_prices, pr_wb_p)
    array.push(pr_names, "WB")
    array.push(pr_ohlc, "H")
    array.push(pr_fibs, "50.0%")
    array.push(pr_types, "proj")

    array.push(pr_ts, pr_wc_ts)
    array.push(pr_prices, pr_wc_p)
    array.push(pr_names, "WC")
    array.push(pr_ohlc, "L")
    array.push(pr_fibs, "61.8%")
    array.push(pr_types, "proj")

    // Primary segment colors
    array<color> pr_segColors = array.new<color>()
    array.push(pr_segColors, PR_MOTIVE_UP)    // W0->W1
    array.push(pr_segColors, PR_CORRECTIVE)    // W1->W2
    array.push(pr_segColors, PR_MOTIVE_UP)    // W2->W3
    array.push(pr_segColors, PR_CORRECTIVE)    // W3->W4
    array.push(pr_segColors, PR_MOTIVE_UP)    // W4->W5
    array.push(pr_segColors, PR_CORRECTIVE)    // W5->WA
    array.push(pr_segColors, PR_CORRECTIVE)    // WA->WB
    array.push(pr_segColors, PR_CORRECTIVE)    // WB->WC

    // === BUILD ALTERNATE ARRAYS ===
    array<int> al_ts = array.new<int>()
    array<float> al_prices = array.new<float>()
    array<string> al_names = array.new<string>()
    array<string> al_ohlc = array.new<string>()
    array<string> al_fibs = array.new<string>()
    array<string> al_types = array.new<string>()

    array.push(al_ts, al_wa_ts)
    array.push(al_prices, al_wa_p)
    array.push(al_names, "WA")
    array.push(al_ohlc, "L")
    array.push(al_fibs, "--")
    array.push(al_types, "hist")

    array.push(al_ts, al_wa2_ts)
    array.push(al_prices, al_wa2_p)
    array.push(al_names, "WA")
    array.push(al_ohlc, "H")
    array.push(al_fibs, "--")
    array.push(al_types, "hist")

    array.push(al_ts, al_wb_ts)
    array.push(al_prices, al_wb_p)
    array.push(al_names, "WB")
    array.push(al_ohlc, "L")
    array.push(al_fibs, "73.0%")
    array.push(al_types, "hist")

    array.push(al_ts, al_wcp_ts)
    array.push(al_prices, al_wcp_p)
    array.push(al_names, "WC.p")
    array.push(al_ohlc, "H")
    array.push(al_fibs, "38.2%")
    array.push(al_types, "proj")

    array.push(al_ts, al_wc_ts)
    array.push(al_prices, al_wc_p)
    array.push(al_names, "WC")
    array.push(al_ohlc, "L")
    array.push(al_fibs, "61.8%")
    array.push(al_types, "proj")

    array.push(al_ts, al_wd_ts)
    array.push(al_prices, al_wd_p)
    array.push(al_names, "WD")
    array.push(al_ohlc, "H")
    array.push(al_fibs, "1.0x")
    array.push(al_types, "proj")

    // Alternate segment colors
    array<color> al_segColors = array.new<color>()
    array.push(al_segColors, AL_MOTIVE_UP)     // WA(L)->WA(H)
    array.push(al_segColors, AL_CORRECTIVE)     // WA(H)->WB
    array.push(al_segColors, AL_MOTIVE_UP)     // WB->WC.p
    array.push(al_segColors, AL_CORRECTIVE)     // WC.p->WC
    array.push(al_segColors, AL_MOTIVE_UP)     // WC->WD

    // === Y-OFFSET COLLISION AVOIDANCE ===
    array<float> pr_yoffs = array.new<float>(array.size(pr_prices), 0.0)
    array<float> al_yoffs = array.new<float>(array.size(al_prices), 0.0)

    int pr_sz = array.size(pr_prices)
    int idx1 = 0
    while idx1 < pr_sz
        int idx2 = idx1 + 1
        while idx2 < pr_sz
            // array size checked before access
            float p1 = array.size(pr_prices) > idx1 ? array.get(pr_prices, idx1) : 0.0
            float p2 = array.size(pr_prices) > idx2 ? array.get(pr_prices, idx2) : 0.0
            int t1 = array.size(pr_ts) > idx1 ? array.get(pr_ts, idx1) : 0
            int t2 = array.size(pr_ts) > idx2 ? array.get(pr_ts, idx2) : 0
            if math.abs(p1 - p2) < priceRange * 0.05 and math.abs(t1 - t2) < 8 * 7 * 86400000
                // array size checked before access
                string ohlc2 = array.size(pr_ohlc) > idx2 ? array.get(pr_ohlc, idx2) : "H"
                float offAmt = priceRange * 0.03
                if ohlc2 == "H"
                    array.set(pr_yoffs, idx2, offAmt)
                else
                    array.set(pr_yoffs, idx2, -offAmt)
            idx2 += 1
        idx1 += 1

    int al_sz = array.size(al_prices)
    int aidx1 = 0
    while aidx1 < al_sz
        int aidx2 = aidx1 + 1
        while aidx2 < al_sz
            // array size checked before access
            float ap1 = array.size(al_prices) > aidx1 ? array.get(al_prices, aidx1) : 0.0
            float ap2 = array.size(al_prices) > aidx2 ? array.get(al_prices, aidx2) : 0.0
            int at1 = array.size(al_ts) > aidx1 ? array.get(al_ts, aidx1) : 0
            int at2 = array.size(al_ts) > aidx2 ? array.get(al_ts, aidx2) : 0
            if math.abs(ap1 - ap2) < priceRange * 0.05 and math.abs(at1 - at2) < 8 * 7 * 86400000
                // array size checked before access
                string aohlc2 = array.size(al_ohlc) > aidx2 ? array.get(al_ohlc, aidx2) : "H"
                float aoffAmt = priceRange * 0.03
                if aohlc2 == "H"
                    array.set(al_yoffs, aidx2, aoffAmt)
                else
                    array.set(al_yoffs, aidx2, -aoffAmt)
            aidx2 += 1
        aidx1 += 1

    // === DETERMINE RENDERING FLAGS ===
    bool drawPrimary = showCount == "Primary Only" or showCount == "Both"
    bool drawAlternate = showCount == "Alternate Only" or showCount == "Both"
    bool altOnly = showCount == "Alternate Only"

    // === DRAW PRIMARY COUNT ===
    if drawPrimary
        int i = 1
        while i < array.size(pr_ts)
            // array size checked before access
            int ts1 = array.size(pr_ts) > (i - 1) ? array.get(pr_ts, i - 1) : 0
            int ts2 = array.size(pr_ts) > i ? array.get(pr_ts, i) : 0
            float p1 = array.size(pr_prices) > (i - 1) ? array.get(pr_prices, i - 1) : 0.0
            float p2 = array.size(pr_prices) > i ? array.get(pr_prices, i) : 0.0
            string type1 = array.size(pr_types) > (i - 1) ? array.get(pr_types, i - 1) : "hist"
            string type2 = array.size(pr_types) > i ? array.get(pr_types, i) : "hist"
            color segCol = array.size(pr_segColors) > (i - 1) ? array.get(pr_segColors, i - 1) : PR_MOTIVE_UP

            bool isHist = type1 == "hist" and type2 == "hist"
            bool isProj = type1 == "proj" or type2 == "proj"

            bool shouldDraw = true
            if isProj and not showProj
                shouldDraw := false

            if shouldDraw
                string lstyle = isHist ? STYLE_SOLID : STYLE_DOTTED
                line seg = line.new(ts1, p1, ts2, p2, xloc=xloc.bar_time, color=segCol, style=lstyle, width=2)
                array.push(allLines, seg)
            i += 1

        // Primary labels
        if showLabels
            int li = 0
            while li < array.size(pr_ts)
                // array size checked before access
                string ltype = array.size(pr_types) > li ? array.get(pr_types, li) : "hist"
                bool isProj2 = ltype == "proj"
                if isProj2 and not showProj
                    li += 1
                    continue

                int lts = array.size(pr_ts) > li ? array.get(pr_ts, li) : 0
                float lprice = array.size(pr_prices) > li ? array.get(pr_prices, li) : 0.0
                string lname = array.size(pr_names) > li ? array.get(pr_names, li) : ""
                string lohlc = array.size(pr_ohlc) > li ? array.get(pr_ohlc, li) : "H"
                string lfib = array.size(pr_fibs) > li ? array.get(pr_fibs, li) : "--"
                float lyoff = array.size(pr_yoffs) > li ? array.get(pr_yoffs, li) : 0.0

                string ltxt = makePivotText(lname, lprice, lfib, false, isProj2)
                float labelY = lprice + lyoff
                string lswTooltip = lname == "W1" ? "W1.sw5\nFib:1.24x" : lname == "W2" ? "W2.swc\nFib:0.71x" : lname == "W3" ? "W3.sw5\nFib:0.82x" : lname == "W4" ? "W4.swc\nFib:1.43x" : lname == "W5" ? "W5.sw5\nFib:0.84x" : lname == "WA" ? "WA.swc\nFib:0.81x" : na

                color lblCol = PR_MOTIVE_UP
                if li > 0
                    // array size checked before access
                    lblCol := array.size(pr_segColors) > (li - 1) ? array.get(pr_segColors, li - 1) : PR_MOTIVE_UP

                if lohlc == "H"
                    label lbl = label.new(lts, labelY, ltxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=lblCol, textcolor=color.white, size=size.small, textalign=text.align_center, tooltip=lswTooltip)
                    array.push(allLabels, lbl)
                else
                    label lbl = label.new(lts, labelY, ltxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, color=lblCol, textcolor=color.white, size=size.small, textalign=text.align_center, tooltip=lswTooltip)
                    array.push(allLabels, lbl)
                li += 1

    // === DRAW ALTERNATE COUNT ===
    if drawAlternate
        int i = 1
        while i < array.size(al_ts)
            // array size checked before access
            int ts1 = array.size(al_ts) > (i - 1) ? array.get(al_ts, i - 1) : 0
            int ts2 = array.size(al_ts) > i ? array.get(al_ts, i) : 0
            float p1 = array.size(al_prices) > (i - 1) ? array.get(al_prices, i - 1) : 0.0
            float p2 = array.size(al_prices) > i ? array.get(al_prices, i) : 0.0
            string type1 = array.size(al_types) > (i - 1) ? array.get(al_types, i - 1) : "hist"
            string type2 = array.size(al_types) > i ? array.get(al_types, i) : "hist"
            color segCol = array.size(al_segColors) > (i - 1) ? array.get(al_segColors, i - 1) : AL_MOTIVE_UP

            bool isHist = type1 == "hist" and type2 == "hist"
            bool isProj = type1 == "proj" or type2 == "proj"

            bool shouldDraw = true
            if isProj and not showProj
                shouldDraw := false

            if shouldDraw
                string lstyle = STYLE_DASHED
                if isProj
                    lstyle := STYLE_DOTTED
                if altOnly and isHist
                    lstyle := STYLE_SOLID
                int alTransp = altOnly ? 0 : 50
                color alSegCol = color.new(segCol, alTransp)
                line seg = line.new(ts1, p1, ts2, p2, xloc=xloc.bar_time, color=alSegCol, style=lstyle, width=2)
                array.push(allLines, seg)
            i += 1

        // Alternate labels
        if showLabels
            int li = 0
            while li < array.size(al_ts)
                // array size checked before access
                string ltype = array.size(al_types) > li ? array.get(al_types, li) : "hist"
                bool isProj2 = ltype == "proj"
                if isProj2 and not showProj
                    li += 1
                    continue

                int lts = array.size(al_ts) > li ? array.get(al_ts, li) : 0
                float lprice = array.size(al_prices) > li ? array.get(al_prices, li) : 0.0
                string lname = array.size(al_names) > li ? array.get(al_names, li) : ""
                string lohlc = array.size(al_ohlc) > li ? array.get(al_ohlc, li) : "H"
                string lfib = array.size(al_fibs) > li ? array.get(al_fibs, li) : "--"
                float lyoff = array.size(al_yoffs) > li ? array.get(al_yoffs, li) : 0.0

                string ltxt = makePivotText(lname, lprice, lfib, true, isProj2)
                float labelY = lprice + lyoff

                color lblCol = AL_MOTIVE_UP
                if li > 0
                    // array size checked before access
