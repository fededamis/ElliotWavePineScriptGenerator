                    else
                        label aslbl = label.new(aslts, aslp, asltxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, color=alswAcol, textcolor=color.white, size=size.tiny, textalign=text.align_center, tooltip=asltooltip)
                        array.push(allLabels, aslbl)
                    asli += 1

        // Alt WB subwaves
        array<int> aswB_ts = array.new<int>()
        array<float> aswB_p = array.new<float>()
        array<string> aswB_names = array.new<string>()
        array<string> aswB_ohlc = array.new<string>()
        array<string> aswB_fibs = array.new<string>()
        array.push(aswB_ts, al_wbswa_ts)
        array.push(aswB_p, al_wbswa_p)
        array.push(aswB_names, "WB.swa")
        array.push(aswB_ohlc, "L")
        array.push(aswB_fibs, "--")
        array.push(aswB_ts, al_wbswb_ts)
        array.push(aswB_p, al_wbswb_p)
        array.push(aswB_names, "WB.swb")
        array.push(aswB_ohlc, "H")
        array.push(aswB_fibs, "95.4%")
        array.push(aswB_ts, al_wbswc_ts)
        array.push(aswB_p, al_wbswc_p)
        array.push(aswB_names, "WB.swc")
        array.push(aswB_ohlc, "L")
        array.push(aswB_fibs, "1.19x")

        if array.size(aswB_ts) > 0
            int asBi = 1
            while asBi < array.size(aswB_ts)
                // array size checked before access
                line aswl = line.new(array.get(aswB_ts, asBi - 1), array.get(aswB_p, asBi - 1), array.get(aswB_ts, asBi), array.get(aswB_p, asBi), xloc=xloc.bar_time, color=alswBcol, style=STYLE_DASHED, width=1)
                array.push(allLines, aswl)
                asBi += 1

        if showLabels
            if array.size(aswB_ts) > 0
                int asli = 0
                while asli < array.size(aswB_ts)
                    // array size checked before access
                    string aslohlc = array.get(aswB_ohlc, asli)
                    string asln = array.get(aswB_names, asli)
                    float aslp = array.get(aswB_p, asli)
                    string aslf = array.get(aswB_fibs, asli)
                    string asltxt = asln
                    string asltooltip = "$" + str.tostring(aslp, "#.##") + (aslf != "--" ? "\nFib:" + aslf : "")
                    int aslts = array.get(aswB_ts, asli)
                    if aslohlc == "H"
                        label aslbl = label.new(aslts, aslp, asltxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=alswBcol, textcolor=color.white, size=size.tiny, textalign=text.align_center, tooltip=asltooltip)
                        array.push(allLabels, aslbl)
                    else
                        label aslbl = label.new(aslts, aslp, asltxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, color=alswBcol, textcolor=color.white, size=size.tiny, textalign=text.align_center, tooltip=asltooltip)
                        array.push(allLabels, aslbl)
                    asli += 1

    // === INVALIDATION LEVELS ===
    if showInval
        if drawPrimary
            line prInvalLine = line.new(pr_w5_ts, pr_inval, pr_wc_ts, pr_inval, xloc=xloc.bar_time, color=PR_INVAL_COL, style=STYLE_DASHED, width=1)
            array.push(allLines, prInvalLine)
            if showLabels
                string prInvalTxt = "Primary Inval\n$" + str.tostring(pr_inval, "#.##")
                label prInvalLbl = label.new(pr_w5_ts, pr_inval, prInvalTxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=PR_INVAL_COL, textcolor=color.white, size=size.small, textalign=text.align_center)
                array.push(allLabels, prInvalLbl)

        if drawAlternate
            line alInvalLine = line.new(al_wa_ts, al_inval, al_wd_ts, al_inval, xloc=xloc.bar_time, color=AL_INVAL_COL, style=STYLE_DASHED, width=1)
            array.push(allLines, alInvalLine)
            if showLabels
                string alInvalTxt = "Alt Inval\n$" + str.tostring(al_inval, "#.##")
                label alInvalLbl = label.new(al_wa_ts, al_inval, alInvalTxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, color=AL_INVAL_COL, textcolor=color.white, size=size.small, textalign=text.align_center)
                array.push(allLabels, alInvalLbl)

    // === TARGET LEVELS ===
    if showTargets
        if drawPrimary
            line prTargetLine = line.new(pr_wa_ts, pr_target, pr_wc_ts, pr_target, xloc=xloc.bar_time, color=PR_TARGET_COL, style=STYLE_DOTTED, width=1)
            array.push(allLines, prTargetLine)
            if showLabels
                string prTargetTxt = "Primary Target\n$" + str.tostring(pr_target, "#.##") + "\nFib " + pr_target_fib
                label prTargetLbl = label.new(pr_wc_ts, pr_target, prTargetTxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, color=PR_TARGET_COL, textcolor=color.black, size=size.small, textalign=text.align_center)
                array.push(allLabels, prTargetLbl)

        if drawAlternate
            line alTargetLine = line.new(al_wb_ts, al_target, al_wc_ts, al_target, xloc=xloc.bar_time, color=AL_TARGET_COL, style=STYLE_DOTTED, width=1)
            array.push(allLines, alTargetLine)
            if showLabels
                string alTargetTxt = "Alt Target\n$" + str.tostring(al_target, "#.##") + "\nFib " + al_target_fib
                label alTargetLbl = label.new(al_wc_ts, al_target, alTargetTxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=AL_TARGET_COL, textcolor=color.white, size=size.small, textalign=text.align_center)
                array.push(allLabels, alTargetLbl)

    // === LEGEND ===
    if showLegend
        int firstPivotTs = pr_w0_ts
        float highestPrice = priceHigh
        float lowestPrice = priceLow
        float legendStep = priceRange * 0.04

        int leg_x = todayTime + 86400000 * 7
        float leg_base = lowestPrice

        if legendPos == "Top Right"
            leg_x := todayTime + 86400000 * 7
            leg_base := highestPrice
        else if legendPos == "Bottom Right"
            leg_x := todayTime + 86400000 * 7
            leg_base := lowestPrice
        else if legendPos == "Top Left"
            leg_x := firstPivotTs - 86400000 * 30
            leg_base := highestPrice
        else if legendPos == "Bottom Left"
            leg_x := firstPivotTs - 86400000 * 30
            leg_base := lowestPrice

        if drawPrimary
            string prLegTxt = "Primary Count (60%)"
            label prLegLbl = label.new(leg_x, leg_base, prLegTxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=PR_MOTIVE_UP, textcolor=color.white, size=size.small, textalign=text.align_center)
            array.push(allLabels, prLegLbl)

        if drawAlternate
            float altLegY = leg_base - legendStep
            string alLegTxt = "Alternate Count (30%)"
            label alLegLbl = label.new(leg_x, altLegY, alLegTxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=AL_MOTIVE_UP, textcolor=color.white, size=size.small, textalign=text.align_center)
            array.push(allLabels, alLegLbl)