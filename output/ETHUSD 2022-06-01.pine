    // ─── Legend ──────────────────────────────────────────────────────────────
    if showLegend
        float legendStep = priceRange * 0.04
        int leg_x = 0
        float leg_base = 0.0
        if legendPos == "Top Right"
            leg_x := todayTime + 86400000 * 7
            leg_base := priceHigh
        else if legendPos == "Top Left"
            leg_x := pr_w0_ts - 86400000 * 30
            leg_base := priceHigh
        else if legendPos == "Bottom Left"
            leg_x := pr_w0_ts - 86400000 * 30
            leg_base := priceLow
        else
            leg_x := todayTime + 86400000 * 7
            leg_base := priceLow
        if drawPrimary
            array.push(allLabels, label.new(leg_x, leg_base, "Primary Count (72%)", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=PR_MOTIVE_UP, textcolor=color.white, size=size.small, textalign=text.align_center))
