            array.push(allLabels, label.new(leg_x, leg_base - legendStep, "Alternate Count (55%)", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=AL_MOTIVE_UP, textcolor=color.white, size=size.small, textalign=text.align_center))
