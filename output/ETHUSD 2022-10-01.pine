                array.push(allLabels, label.new(pr_w4_ts, pr_target, "Primary Target\n$" + str.tostring(pr_target, "#.##") + "\nFib " + pr_target_fib, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=PR_TARGET_COL, textcolor=color.black, size=size.small, textalign=text.align_center))
