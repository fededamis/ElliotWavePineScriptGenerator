//@version=6
// Wave data loaded from cache file
indicator("ETHUSD Elliott Wave Count", overlay=true, max_lines_count=500, max_labels_count=500)

string showCount = input.string("Primary Only", "Show Count", options=["Primary Only", "Both", "Alternate Only"])
bool showInval = input.bool(true, "Show Invalidation Levels")
bool showTargets = input.bool(true, "Show Targets")
bool showLegend = input.bool(true, "Show Legend")
string legendPos = input.string("Bottom Right", "Legend Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"])
bool showProj = input.bool(true, "Show Projections")
bool showLabels = input.bool(true, "Show Labels")
bool showSubwaves = input.bool(true, "Show Subwaves")
bool showChannel = input.bool(false, "Show Channel")

// === COLOR INPUTS ===
color PR_MOTIVE_UP   = input.color(color.aqua,              "Primary Up (Motive)",   group="Colors")
color PR_MOTIVE_DN   = input.color(color.fuchsia,           "Primary Down (Motive)", group="Colors")
color PR_CORRECTIVE  = input.color(color.orange,            "Primary Corrective",    group="Colors")
color PR_INVAL_COL   = input.color(color.red,               "Invalidation Level",    group="Colors")
color PR_TARGET_COL  = input.color(color.lime,               "Target Level",          group="Colors")
color AL_MOTIVE_UP   = input.color(color.rgb(85, 153, 170),  "Alt Up (Motive)",       group="Colors")
color AL_MOTIVE_DN   = input.color(color.rgb(170, 85, 170),  "Alt Down (Motive)",     group="Colors")
color AL_CORRECTIVE  = input.color(color.rgb(170, 119, 51),  "Alt Corrective",        group="Colors")
color AL_INVAL_COL   = input.color(color.rgb(204, 68, 68),   "Alt Invalidation",      group="Colors")
color AL_TARGET_COL  = input.color(color.rgb(68, 136, 68),   "Alt Target",            group="Colors")
color PR_CHANNEL_COL = input.color(color.aqua,               "Primary Channel",       group="Colors")
color AL_CHANNEL_COL = input.color(color.rgb(85, 153, 170),  "Alt Channel",           group="Colors")
int   swLabelTransp  = input.int(0, "Subwave Label Transparency", minval=0, maxval=100, group="Colors")

string STYLE_SOLID = line.style_solid
string STYLE_DASHED = line.style_dashed
string STYLE_DOTTED = line.style_dotted

var array<line> allLines = array.new<line>()
var array<label> allLabels = array.new<label>()

makePivotText(waveName, price, fib, isAlt, isProj) =>
    string line1 = ""
    if isAlt and isProj
        line1 := "(A)(proj) " + waveName
    else if isAlt
        line1 := "(A) " + waveName
    else if isProj
        line1 := "(proj) " + waveName
    else
        line1 := waveName
    string line2 = "$" + str.tostring(price, "#.##")
    string line3 = fib != "--" ? "Fib:" + fib : ""
    string result = line3 != "" ? line1 + "\n" + line2 + "\n" + line3 : line1 + "\n" + line2
    result

// Primary pivots
int pr_w0_ts = timestamp(2022, 11, 21)
float pr_w0_p = 1081.14
int pr_wa_ts = timestamp(2024, 3, 11)
float pr_wa_p = 4092.28
int pr_wb_ts = timestamp(2025, 4, 7)
float pr_wb_p = 1386.80
int pr_wc_ts = timestamp(2025, 8, 18)
float pr_wc_p = 4953.73
int pr_w1_ts = timestamp(2026, 6, 6)
float pr_w1_p = 1506.51
int pr_w2_ts = timestamp(2026, 7, 15)
float pr_w2_p = 1944.16
int pr_w3_ts = timestamp(2026, 12, 12)
float pr_w3_p = 1108.17
int pr_w4_ts = timestamp(2027, 2, 10)
float pr_w4_p = 1298.78

float pr_inval = 4953.73
float pr_target = 1108.17
string pr_target_fib = "24.3%"

// Alternate pivots
int al_w0_ts = timestamp(2022, 11, 21)
float al_w0_p = 1081.14
int al_wa_ts = timestamp(2024, 3, 11)
float al_wa_p = 4092.28
int al_wb_ts = timestamp(2025, 4, 7)
float al_wb_p = 1386.80
int al_wx_ts = timestamp(2025, 8, 18)
float al_wx_p = 4953.73
int al_wy_ts = timestamp(2026, 6, 6)
float al_wy_p = 1506.51
int al_wc_ts = timestamp(2027, 6, 15)
float al_wc_p = 5200.00

float al_inval = 1506.51
float al_target = 5200.00
string al_target_fib = "122.7%"

// Primary subwaves
int pr_waswa_ts = timestamp(2023, 4, 10)
float pr_waswa_p = 2137.45
int pr_waswb_ts = timestamp(2023, 10, 9)
float pr_waswb_p = 1523.24
int pr_waswc_ts = timestamp(2024, 3, 11)
float pr_waswc_p = 4092.28

int pr_wbswa_ts = timestamp(2024, 8, 5)
float pr_wbswa_p = 2122.55
int pr_wbswb_ts = timestamp(2024, 12, 16)
float pr_wbswb_p = 4106.96
int pr_wbswc_ts = timestamp(2025, 4, 7)
float pr_wbswc_p = 1386.80

int pr_wcswa_ts = timestamp(2025, 6, 9)
float pr_wcswa_p = 2877.63
int pr_wcswb_ts = timestamp(2025, 6, 16)
float pr_wcswb_p = 2116.68
int pr_wcswc_ts = timestamp(2025, 8, 18)
float pr_wcswc_p = 4953.73

int pr_w1sw1_ts = timestamp(2025, 11, 17)
float pr_w1sw1_p = 2626.87
int pr_w1sw2_ts = timestamp(2025, 12, 8)
float pr_w1sw2_p = 3446.62
int pr_w1sw3_ts = timestamp(2026, 2, 2)
float pr_w1sw3_p = 1748.63
int pr_w1sw4_ts = timestamp(2026, 4, 13)
float pr_w1sw4_p = 2464.78
int pr_w1sw5_ts = timestamp(2026, 6, 6)
float pr_w1sw5_p = 1506.51

int pr_w2swa_ts = timestamp(2026, 6, 15)
float pr_w2swa_p = 1847.77
int pr_w2swb_ts = timestamp(2026, 6, 26)
float pr_w2swb_p = 1510.51
int pr_w2swc_ts = timestamp(2026, 7, 15)
float pr_w2swc_p = 1944.16

// Alternate subwaves (WX mirrors WC, WY mirrors W1)
int al_wxswa_ts = timestamp(2025, 6, 9)
float al_wxswa_p = 2877.63
int al_wxswb_ts = timestamp(2025, 6, 16)
float al_wxswb_p = 2116.68
int al_wxswc_ts = timestamp(2025, 8, 18)
float al_wxswc_p = 4953.73

int al_wysw1_ts = timestamp(2025, 11, 17)
float al_wysw1_p = 2626.87
int al_wysw2_ts = timestamp(2025, 12, 8)
float al_wysw2_p = 3446.62
int al_wysw3_ts = timestamp(2026, 2, 2)
float al_wysw3_p = 1748.63
int al_wysw4_ts = timestamp(2026, 4, 13)
float al_wysw4_p = 2464.78
int al_wysw5_ts = timestamp(2026, 6, 6)
float al_wysw5_p = 1506.51

// All drawing objects use xloc.bar_time + fixed float prices for scale/zoom stability
if barstate.islast
    // array size checked before access
    while array.size(allLines) > 0
        line.delete(array.pop(allLines))
    // array size checked before access
    while array.size(allLabels) > 0
        label.delete(array.pop(allLabels))

    int todayTime = time
    float priceHigh = 5200.00
    float priceLow = 1081.14
    float priceRange = priceHigh - priceLow

    array<int> pr_ts = array.new<int>()
    array<float> pr_prices = array.new<float>()
    array<string> pr_names = array.new<string>()
    array<string> pr_ohlc = array.new<string>()
    array<string> pr_fibs = array.new<string>()
    array<string> pr_types = array.new<string>()

    array.push(pr_ts, pr_w0_ts)
    array.push(pr_prices, pr_w0_p)
    array.push(pr_names, "W0")
    array.push(pr_ohlc, "L")
    array.push(pr_fibs, "--")
    array.push(pr_types, "hist")

    array.push(pr_ts, pr_wa_ts)
    array.push(pr_prices, pr_wa_p)
    array.push(pr_names, "WA")
    array.push(pr_ohlc, "H")
    array.push(pr_fibs, "--")
    array.push(pr_types, "hist")

    array.push(pr_ts, pr_wb_ts)
    array.push(pr_prices, pr_wb_p)
    array.push(pr_names, "WB")
    array.push(pr_ohlc, "L")
    array.push(pr_fibs, "89.9%")
    array.push(pr_types, "hist")

    array.push(pr_ts, pr_wc_ts)
    array.push(pr_prices, pr_wc_p)
    array.push(pr_names, "WC")
    array.push(pr_ohlc, "H")
    array.push(pr_fibs, "118.5%")
    array.push(pr_types, "hist")

    array.push(pr_ts, pr_w1_ts)
    array.push(pr_prices, pr_w1_p)
    array.push(pr_names, "W1")
    array.push(pr_ohlc, "L")
    array.push(pr_fibs, "100.0%")
    array.push(pr_types, "hist")

    array.push(pr_ts, pr_w2_ts)
    array.push(pr_prices, pr_w2_p)
    array.push(pr_names, "W2")
    array.push(pr_ohlc, "H")
    array.push(pr_fibs, "12.7%")
    array.push(pr_types, "hist")

    array.push(pr_ts, pr_w3_ts)
    array.push(pr_prices, pr_w3_p)
    array.push(pr_names, "W3")
    array.push(pr_ohlc, "L")
    array.push(pr_fibs, "24.3%")
    array.push(pr_types, "proj")

    array.push(pr_ts, pr_w4_ts)
    array.push(pr_prices, pr_w4_p)
    array.push(pr_names, "W4")
    array.push(pr_ohlc, "H")
    array.push(pr_fibs, "22.8%")
    array.push(pr_types, "proj")

    array<color> pr_segColors = array.new<color>()
    array.push(pr_segColors, PR_CORRECTIVE)
    array.push(pr_segColors, PR_CORRECTIVE)
    array.push(pr_segColors, PR_CORRECTIVE)
    array.push(pr_segColors, PR_MOTIVE_DN)
    array.push(pr_segColors, PR_CORRECTIVE)
    array.push(pr_segColors, PR_MOTIVE_DN)
    array.push(pr_segColors, PR_CORRECTIVE)

    array<int> al_ts = array.new<int>()
    array<float> al_prices = array.new<float>()
    array<string> al_names = array.new<string>()
    array<string> al_ohlc = array.new<string>()
    array<string> al_fibs = array.new<string>()
    array<string> al_types = array.new<string>()

    array.push(al_ts, al_w0_ts)
    array.push(al_prices, al_w0_p)
    array.push(al_names, "W0")
    array.push(al_ohlc, "L")
    array.push(al_fibs, "--")
    array.push(al_types, "hist")

    array.push(al_ts, al_wa_ts)
    array.push(al_prices, al_wa_p)
    array.push(al_names, "WA")
    array.push(al_ohlc, "H")
    array.push(al_fibs, "--")
    array.push(al_types, "hist")

    array.push(al_ts, al_wb_ts)
    array.push(al_prices, al_wb_p)
    array.push(al_names, "WB")
    array.push(al_ohlc, "L")
    array.push(al_fibs, "89.9%")
    array.push(al_types, "hist")

    array.push(al_ts, al_wx_ts)
    array.push(al_prices, al_wx_p)
    array.push(al_names, "WX")
    array.push(al_ohlc, "H")
    array.push(al_fibs, "118.5%")
    array.push(al_types, "hist")

    array.push(al_ts, al_wy_ts)
    array.push(al_prices, al_wy_p)
    array.push(al_names, "WY")
    array.push(al_ohlc, "L")
    array.push(al_fibs, "96.6%")
    array.push(al_types, "hist")

    array.push(al_ts, al_wc_ts)
    array.push(al_prices, al_wc_p)
    array.push(al_names, "WC")
    array.push(al_ohlc, "H")
    array.push(al_fibs, "122.7%")
    array.push(al_types, "proj")

    array<color> al_segColors = array.new<color>()
    array.push(al_segColors, AL_CORRECTIVE)
    array.push(al_segColors, AL_CORRECTIVE)
    array.push(al_segColors, AL_CORRECTIVE)
    array.push(al_segColors, AL_CORRECTIVE)
    array.push(al_segColors, AL_CORRECTIVE)

    array<float> pr_yoffs = array.new<float>(array.size(pr_prices), 0.0)
    array<float> al_yoffs = array.new<float>(array.size(al_prices), 0.0)

    int pr_sz = array.size(pr_prices)
    int idx1 = 0
    while idx1 < pr_sz
        int idx2 = idx1 + 1
        while idx2 < pr_sz
            float p1 = array.get(pr_prices, idx1)
            float p2 = array.get(pr_prices, idx2)
            int t1 = array.get(pr_ts, idx1)
            int t2 = array.get(pr_ts, idx2)
            if math.abs(p1 - p2) < priceRange * 0.05 and math.abs(t1 - t2) < 8 * 7 * 86400000
                string ohlc2 = array.get(pr_ohlc, idx2)
                float offAmt = priceRange * 0.03
                if ohlc2 == "H"
                    array.set(pr_yoffs, idx2, offAmt)
                else
                    array.set(pr_yoffs, idx2, -offAmt)
            idx2 += 1
        idx1 += 1

    int al_sz = array.size(al_prices)
    int aidx1 = 0
    while aidx1 < al_sz
        int aidx2 = aidx1 + 1
        while aidx2 < al_sz
            float ap1 = array.get(al_prices, aidx1)
            float ap2 = array.get(al_prices, aidx2)
            int at1 = array.get(al_ts, aidx1)
            int at2 = array.get(al_ts, aidx2)
            if math.abs(ap1 - ap2) < priceRange * 0.05 and math.abs(at1 - at2) < 8 * 7 * 86400000
                string aohlc2 = array.get(al_ohlc, aidx2)
                float aoffAmt = priceRange * 0.03
                if aohlc2 == "H"
                    array.set(al_yoffs, aidx2, aoffAmt)
                else
                    array.set(al_yoffs, aidx2, -aoffAmt)
            aidx2 += 1
        aidx1 += 1

    bool drawPrimary = showCount == "Primary Only" or showCount == "Both"
    bool drawAlternate = showCount == "Alternate Only" or showCount == "Both"
    bool altOnly = showCount == "Alternate Only"

    if drawPrimary
        int i = 1
        while i < array.size(pr_ts)
            int ts1 = array.get(pr_ts, i - 1)
            int ts2 = array.get(pr_ts, i)
            float p1 = array.get(pr_prices, i - 1)
            float p2 = array.get(pr_prices, i)
            string type1 = array.get(pr_types, i - 1)
            string type2 = array.get(pr_types, i)
            color segCol = array.get(pr_segColors, i - 1)
            bool isHist = type1 == "hist" and type2 == "hist"
            bool isProj = type1 == "proj" or type2 == "proj"
            if not isProj or showProj
                string lstyle = isHist ? STYLE_SOLID : STYLE_DOTTED
                array.push(allLines, line.new(ts1, p1, ts2, p2, xloc=xloc.bar_time, color=segCol, style=lstyle, width=2))
            i += 1

        if showLabels
            int li = 0
            while li < array.size(pr_ts)
                string ltype = array.get(pr_types, li)
                bool isProj2 = ltype == "proj"
                if isProj2 and not showProj
                    li += 1
                    continue
                int lts = array.get(pr_ts, li)
                float lprice = array.get(pr_prices, li)
                string lname = array.get(pr_names, li)
                string lohlc = array.get(pr_ohlc, li)
                string lfib = array.get(pr_fibs, li)
                float lyoff = array.get(pr_yoffs, li)
                string ltxt = makePivotText(lname, lprice, lfib, false, isProj2)
                float labelY = lprice + lyoff
                string lswTooltip = lname == "WA" ? "WA.swc\nFib:243.2%" : lname == "WB" ? "WB.swc\nFib:138.1%" : lname == "WC" ? "WC.swc\nFib:190.3%" : lname == "W1" ? "W1.sw5\nFib:41.2%" : lname == "W2" ? "W2.swc\nFib:127.1%" : na
                color lblCol = PR_CORRECTIVE
                if li > 0
                    lblCol := array.get(pr_segColors, li - 1)
                if lohlc == "H"
                    array.push(allLabels, label.new(lts, labelY, ltxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=lblCol, textcolor=color.white, size=size.small, textalign=text.align_center, tooltip=lswTooltip))
                else
                    array.push(allLabels, label.new(lts, labelY, ltxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, color=lblCol, textcolor=color.white, size=size.small, textalign=text.align_center, tooltip=lswTooltip))
                li += 1

    if drawAlternate
        int i = 1
        while i < array.size(al_ts)
            int ts1 = array.get(al_ts, i - 1)
            int ts2 = array.get(al_ts, i)
            float p1 = array.get(al_prices, i - 1)
            float p2 = array.get(al_prices, i)
            string type1 = array.get(al_types, i - 1)
            string type2 = array.get(al_types, i)
            color segCol = array.get(al_segColors, i - 1)
            bool isHist = type1 == "hist" and type2 == "hist"
            bool isProj = type1 == "proj" or type2 == "proj"
            if not isProj or showProj
                string lstyle = STYLE_DASHED
                if isProj
                    lstyle := STYLE_DOTTED
                if altOnly and isHist
                    lstyle := STYLE_SOLID
                int alTransp = altOnly ? 0 : 50
                array.push(allLines, line.new(ts1, p1, ts2, p2, xloc=xloc.bar_time, color=color.new(segCol, alTransp), style=lstyle, width=2))
            i += 1

        if showLabels
            int li = 0
            while li < array.size(al_ts)
                string ltype = array.get(al_types, li)
                bool isProj2 = ltype == "proj"
                if isProj2 and not showProj
                    li += 1
                    continue
                int lts = array.get(al_ts, li)
                float lprice = array.get(al_prices, li)
                string lname = array.get(al_names, li)
                string lohlc = array.get(al_ohlc, li)
                string lfib = array.get(al_fibs, li)
                float lyoff = array.get(al_yoffs, li)
                string ltxt = makePivotText(lname, lprice, lfib, true, isProj2)
                float labelY = lprice + lyoff
                string alswTooltip = lname == "WX" ? "WX.swc\nFib:190.3%" : lname == "WY" ? "WY.sw5\nFib:41.2%" : na
                color lblCol = AL_CORRECTIVE
                if li > 0
                    lblCol := array.get(al_segColors, li - 1)
                color lblColTransp = altOnly ? lblCol : color.new(lblCol, 50)
                if lohlc == "H"
                    array.push(allLabels, label.new(lts, labelY, ltxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=lblColTransp, textcolor=color.white, size=size.small, textalign=text.align_center, tooltip=alswTooltip))
                else
                    array.push(allLabels, label.new(lts, labelY, ltxt, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, color=lblColTransp, textcolor=color.white, size=size.small, textalign=text.align_center, tooltip=alswTooltip))
                li += 1

    if showSubwaves and drawPrimary
        color swCorrCol = color.new(PR_CORRECTIVE, swLabelTransp)
        color swMotiveCol = color.new(PR_MOTIVE_DN, swLabelTransp)

        array<int> swA_ts = array.new<int>()
        array<float> swA_p = array.new<float>()
        array<string> swA_names = array.new<string>()
        array<string> swA_ohlc = array.new<string>()
        array<string> swA_fibs = array.new<string>()
        array.push(swA_ts, pr_waswa_ts)
        array.push(swA_p, pr_waswa_p)
        array.push(swA_names, "WA.swa")
        array.push(swA_ohlc, "H")
        array.push(swA_fibs, "--")
        array.push(swA_ts, pr_waswb_ts)
        array.push(swA_p, pr_waswb_p)
        array.push(swA_names, "WA.swb")
        array.push(swA_ohlc, "L")
        array.push(swA_fibs, "58.2%")
        array.push(swA_ts, pr_waswc_ts)
        array.push(swA_p, pr_waswc_p)
        array.push(swA_names, "WA.swc")
        array.push(swA_ohlc, "H")
        array.push(swA_fibs, "243.2%")

        int sAi = 1
        while sAi < array.size(swA_ts)
            array.push(allLines, line.new(array.get(swA_ts, sAi - 1), array.get(swA_p, sAi - 1), array.get(swA_ts, sAi), array.get(swA_p, sAi), xloc=xloc.bar_time, color=swCorrCol, style=STYLE_DASHED, width=1))
            sAi += 1

        if showLabels
            int sli = 0
            while sli < array.size(swA_ts)
                string slohlc = array.get(swA_ohlc, sli)
                float slp = array.get(swA_p, sli)
                string slf = array.get(swA_fibs, sli)
                string sltooltip = "$" + str.tostring(slp, "#.##") + (slf != "--" ? "\nFib:" + slf : "")
                float sw_yoff = slohlc == "H" ? priceRange * 0.04 : -(priceRange * 0.04)
                bool is_coincident = sli == array.size(swA_ts) - 1
                if not is_coincident
                    if slohlc == "H"
                        array.push(allLabels, label.new(array.get(swA_ts, sli), slp + sw_yoff, array.get(swA_names, sli), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=swCorrCol, textcolor=color.white, size=size.tiny, textalign=text.align_center, tooltip=sltooltip))
                    else
                        array.push(allLabels, label.new(array.get(swA_ts, sli), slp + sw_yoff, array.get(swA_names, sli), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up, color=swCorrCol, textcolor=color.white, size=size.tiny, textalign=text.align_center, tooltip=sltooltip))
                sli += 1

        array<int> swB_ts = array.new<int>()
        array<float> swB_p = array.new<float>()
        array<string> swB_names = array.new<string>()
        array<string> swB_ohlc = array.new<string>()
        array<string> swB_fibs = array.new<string>()
        array.push(swB_ts, pr_wbswa_ts)
        array.push(swB_p, pr_wbswa_p)
        array.push(swB_names, "WB.swa")
        array.push(swB_ohlc, "L")
        array.push(swB_fibs, "--")
        array.push(swB_ts, pr_wbswb_ts)
        array.push(swB_p, pr_wbswb_p)
        array.push(swB_names, "WB.swb")
        array.push(swB_ohlc, "H")
        array.push(swB_fibs, "100.7%")
        array.push(swB_ts, pr_wbswc_ts)
        array.push(swB_p, pr_wbswc_p)
