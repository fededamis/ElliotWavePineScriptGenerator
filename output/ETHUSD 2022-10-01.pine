    bool prImpulseConfirmed = false
    if showChannel and drawPrimary and prImpulseConfirmed
        float ch_slope = (pr_w2_p - pr_wc_p) / float(pr_w2_ts - pr_wc_ts)
        int ch_start_ts = pr_wc_ts
        int ch_end_ts = pr_w4_ts
        float mot_y_start = pr_wc_p + ch_slope * float(ch_start_ts - pr_wc_ts)
        float mot_y_end = pr_wc_p + ch_slope * float(ch_end_ts - pr_wc_ts)
        float base_y_start = pr_w1_p + ch_slope * float(ch_start_ts - pr_w1_ts)
        float base_y_end = pr_w1_p + ch_slope * float(ch_end_ts - pr_w1_ts)
        array.push(allLines, line.new(ch_start_ts, mot_y_start, ch_end_ts, mot_y_end, xloc=xloc.bar_time, color=color.new(PR_CHANNEL_COL, 50), style=STYLE_DASHED, width=1))
        array.push(allLines, line.new(ch_start_ts, base_y_start, ch_end_ts, base_y_end, xloc=xloc.bar_time, color=color.new(PR_CHANNEL_COL, 50), style=STYLE_DASHED, width=1))

